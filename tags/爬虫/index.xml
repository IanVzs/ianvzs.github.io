&lt;h3 id="一表多图"&gt;一表多图&lt;a class="anchor" href="#%e4%b8%80%e8%a1%a8%e5%a4%9a%e5%9b%be"&gt;#&lt;/a&gt;&lt;/h3&gt;
&lt;pre&gt;&lt;code&gt;pCapital = plt.subplot(4, 1, 1)
 pCapital.set_ylabel(&amp;quot;capital&amp;quot;)
