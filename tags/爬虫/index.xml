&lt;h3 id="标注点"&gt;标注点&lt;a class="anchor" href="#%e6%a0%87%e6%b3%a8%e7%82%b9"&gt;#&lt;/a&gt;&lt;/h3&gt;
&lt;h4 id="eg1"&gt;eg1&lt;a class="anchor" href="#eg1"&gt;#&lt;/a&gt;&lt;/h4&gt;
&lt;pre&gt;&lt;code&gt;for w, m in enumerate(self.lowestPrice):
 if w % 120*10 == 0:
 plt.plot([w, w], [m, self.highestPrice[w]], linestyle = '--')
 #plt.scatter(self.dealPoints,color = 'c')
for i in self.dealPoints: 
 plt.scatter([i[0]], [i[1]], color = 'c') 
 for ii in self.ydealPoints:
 plt.scatter([ii[0]], [ii[1]], color = 'm')

plt.title('Tick &amp;amp; TradePoint')
