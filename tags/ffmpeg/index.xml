<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Ffmpeg on Ian's Blog</title><link>http://example.org/tags/ffmpeg/</link><description>Recent content in Ffmpeg on Ian's Blog</description><generator>Hugo</generator><language>en-us</language><lastBuildDate>Fri, 13 Sep 2024 00:00:00 +0000</lastBuildDate><atom:link href="http://example.org/tags/ffmpeg/index.xml" rel="self" type="application/rss+xml"/><item><title>ffmpeg 使用</title><link>http://example.org/docs/programmer/gui/ffmpeg/</link><pubDate>Fri, 13 Sep 2024 00:00:00 +0000</pubDate><guid>http://example.org/docs/programmer/gui/ffmpeg/</guid><description>&lt;h1 id="命令"&gt;命令&lt;a class="anchor" href="#%e5%91%bd%e4%bb%a4"&gt;#&lt;/a&gt;&lt;/h1&gt;
&lt;ul&gt;
&lt;li&gt;[[小命令#13. ffmpeg 提取视频中音频]]&lt;/li&gt;
&lt;li&gt;[[小命令#21. 压缩视频]]&lt;/li&gt;
&lt;/ul&gt;
&lt;h2 id="1-修改图片分辨率"&gt;1. 修改图片分辨率&lt;a class="anchor" href="#1-%e4%bf%ae%e6%94%b9%e5%9b%be%e7%89%87%e5%88%86%e8%be%a8%e7%8e%87"&gt;#&lt;/a&gt;&lt;/h2&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-bash" data-lang="bash"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;ffmpeg -i input.jpg -vf scale&lt;span style="color:#f92672"&gt;=&lt;/span&gt;iw/2:ih/2 output.jpg
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#75715e"&gt;# 集体操作&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#66d9ef"&gt;for&lt;/span&gt; file in *.png; &lt;span style="color:#66d9ef"&gt;do&lt;/span&gt; ffmpeg -i &lt;span style="color:#e6db74"&gt;&amp;#34;&lt;/span&gt;$file&lt;span style="color:#e6db74"&gt;&amp;#34;&lt;/span&gt; -vf scale&lt;span style="color:#f92672"&gt;=&lt;/span&gt;iw/2:ih/2 &lt;span style="color:#e6db74"&gt;&amp;#34;&lt;/span&gt;&lt;span style="color:#e6db74"&gt;${&lt;/span&gt;file%.png&lt;span style="color:#e6db74"&gt;}&lt;/span&gt;&lt;span style="color:#e6db74"&gt;-2.png&amp;#34;&lt;/span&gt;; &lt;span style="color:#66d9ef"&gt;done&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 id="2-压缩图片"&gt;2. 压缩图片&lt;a class="anchor" href="#2-%e5%8e%8b%e7%bc%a9%e5%9b%be%e7%89%87"&gt;#&lt;/a&gt;&lt;/h2&gt;
&lt;blockquote class='book-hint '&gt;
&lt;p&gt;1 - 9 越大越狠&lt;/p&gt;
&lt;/blockquote&gt;&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-bash" data-lang="bash"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;ffmpeg -i input.jpg -compression_level &lt;span style="color:#ae81ff"&gt;9&lt;/span&gt; output.jpg
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#75715e"&gt;# 集体压缩&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#66d9ef"&gt;for&lt;/span&gt; file in *.png; &lt;span style="color:#66d9ef"&gt;do&lt;/span&gt; ffmpeg -i &lt;span style="color:#e6db74"&gt;&amp;#34;&lt;/span&gt;$file&lt;span style="color:#e6db74"&gt;&amp;#34;&lt;/span&gt; -compression_level &lt;span style="color:#ae81ff"&gt;9&lt;/span&gt; &lt;span style="color:#e6db74"&gt;&amp;#34;&lt;/span&gt;&lt;span style="color:#e6db74"&gt;${&lt;/span&gt;file%.png&lt;span style="color:#e6db74"&gt;}&lt;/span&gt;&lt;span style="color:#e6db74"&gt;-2.png&amp;#34;&lt;/span&gt;; &lt;span style="color:#66d9ef"&gt;done&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;</description></item></channel></rss>