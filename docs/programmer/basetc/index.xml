 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;收缩节点&lt;/td&gt;
 &lt;td&gt;Ctrl/Cmd + /&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
